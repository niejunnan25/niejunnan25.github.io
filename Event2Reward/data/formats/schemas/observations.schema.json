{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event2Reward image-file observations",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "task",
      "start",
      "goal",
      "history"
    ],
    "properties": {
      "task": {
        "type": "string",
        "pattern": "\\S"
      },
      "start": {
        "type": "string",
        "minLength": 1
      },
      "goal": {
        "type": "string",
        "minLength": 1
      },
      "history": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "additionalProperties": false
  },
  "$comment": "For the documented CLI file format. Causality, semantic task/goal match and success of the independent goal must be verified separately."
}
